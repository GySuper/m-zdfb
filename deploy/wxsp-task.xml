<?xml version="1.0" encoding="UTF-8"?>
<!--
  wxsp daemon Windows 任务计划程序模板

  使用方法见 README.md "开机自启 (Windows)" 一节。简要:
    1. 把 __INSTALL_DIR__ 替换为项目绝对路径 (如 C:\Users\you\wechat-sph-upload)
    2. 把 __UV_BIN__     替换为 uv.exe 的绝对路径 (where uv)
    3. 把 __USERNAME__   替换为登录账号 (echo %USERNAME%)
    4. 注册:  schtasks /Create /TN "wxsp-daemon" /XML deploy\wxsp-task.xml

  关键: 用 LogonTrigger (登录时触发) 而不是 BootTrigger (开机时跑 Session 0)。
  视频号必须 headless=false 需要真桌面会话; Session 0 没有 UI 会失败。
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>微信视频号自动发布 daemon (09:00 cron + Web UI 守护)</Description>
    <URI>\wxsp-daemon</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USERNAME__</UserId>
      <Delay>PT30S</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USERNAME__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>__UV_BIN__</Command>
      <Arguments>run wxsp run --daemon</Arguments>
      <WorkingDirectory>__INSTALL_DIR__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>

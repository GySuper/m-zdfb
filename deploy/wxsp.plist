<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  wxsp daemon launchd 模板 (macOS)

  使用方法见 README.md "开机自启 (macOS)" 一节。简要:
    1. 把 __INSTALL_DIR__ 替换成项目绝对路径(如 /Users/you/wechat-sph-upload)
    2. 把 __UV_BIN__   替换成 uv 的绝对路径 (which uv)
    3. cp 到 ~/Library/LaunchAgents/com.wxsp.daemon.plist
    4. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wxsp.daemon.plist

  注意: 视频号必须 headless=false; LaunchAgent (gui/) 才能弹浏览器,
  千万别用 LaunchDaemon (system) - 那个跑在 root 没有桌面会话。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wxsp.daemon</string>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_BIN__</string>
        <string>run</string>
        <string>wxsp</string>
        <string>run</string>
        <string>--daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>zh_CN.UTF-8</string>
    </dict>
</dict>
</plist>
